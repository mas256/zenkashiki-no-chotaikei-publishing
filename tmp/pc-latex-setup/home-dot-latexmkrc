# Default build for Japanese LaTeX documents on this PC.
$ENV{'TZ'} = 'Asia/Tokyo';
$latex      = 'uplatex -halt-on-error -interaction=nonstopmode -file-line-error %O %S';
$bibtex     = 'upbibtex %O %B';
$makeindex  = 'upmendex %O -o %D %S';
$dvipdf     = 'dvipdfmx %O -o %D %S';
$pdf_mode   = 3;
$max_repeat = 5;
$recorder   = 1;
$do_cd      = 1;
